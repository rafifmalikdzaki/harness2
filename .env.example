# Harness² configuration.
#
# Copy this file to `.env` and fill in what you need. The shell always wins:
# a variable set in your shell overrides the value here.
#
# Run `harness2-doctor` to check that this machine can actually run the
# harness, and to see which of these it needs.

# ---------------------------------------------------------------------------
# The model service
# ---------------------------------------------------------------------------
# The general path needs ONE of these two. The first is any OpenAI-compatible
# endpoint; the second is Inception Labs, which is what the default points at.
#
#   HARNESS2_LLM_BASE_URL=https://api.example.com/v1
#   HARNESS2_LLM_API_KEY=sk-...
#   HARNESS2_LLM_MODEL=some-model
#
# INCEPTION_API_KEY=sk-...
#
# The same service runs the solver, the improver and the selector. That is the
# default (`--channel http`), so one key runs the whole loop.

# INCEPTION_API_KEY=
# HARNESS2_INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
# HARNESS2_INCEPTION_MODEL=mercury-3

# ---------------------------------------------------------------------------
# Models on the OpenCode channel
# ---------------------------------------------------------------------------
# Only needed for `--channel opencode` and for the benchmark paths, which run
# their rollouts through the OpenCode CLI. These ids are PROVIDER-PREFIXED,
# the way OpenCode names them.
#
# HARNESS2_SOLVER_MODEL=anthropic/claude-sonnet-4-5
# HARNESS2_IMPROVER_MODEL=anthropic/claude-sonnet-4-5
# HARNESS2_IMPROVER_MODEL_HTTP=      # empty -> the provider's own model

# ---------------------------------------------------------------------------
# Benchmark paths (JobBench, LabBench, WorkBuddy)
# ---------------------------------------------------------------------------
# HARNESS2_CODEX_MODEL=
# HARNESS2_CODEX_BASE_URL=
# HARNESS2_CODEX_API_KEY=
# HARNESS2_CODEX_CONTAINER_URL=
# HARNESS2_JUDGE_MODEL=
# HARNESS2_JUDGE_BASE_URL=
# HARNESS2_JUDGE_API_KEY=

# ---------------------------------------------------------------------------
# Where things live
# ---------------------------------------------------------------------------
# HARNESS2_RUNS_DIR=./runs
# HARNESS2_OPENCODE_BIN=opencode
# HARNESS2_VERTEX_PROJECT=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
